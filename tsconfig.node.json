{
  // Lo que se ejecuta en Node, no en el navegador: la configuracion de Vite y las
  // pruebas de los scripts de compilacion (`scripts/*.spec.ts`).
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",

    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "composite": true,

    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,

    "types": ["node"]
  },
  // `src/rutas/rutas.ts` entra porque las pruebas de los scripts la leen (para que una
  // ruta nueva no se quede sin reescritura ni sin clasificar). No tiene nada del
  // navegador: son cadenas.
  "include": ["vite.config.ts", "scripts/**/*.spec.ts", "src/rutas/rutas.ts"]
}
